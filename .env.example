# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=prpo_system

# Server Configuration
PORT=3000
NODE_ENV=development

# Security
JWT_SECRET=your-secret-key-change-this

# Company
COMPANY_NAME=Love Andaman

# PEAK Open API (https://developers.peakaccount.com)
# connectId + password มาจากอีเมลที่ PEAK ส่งให้
PEAK_CONNECT_ID=
PEAK_PASSWORD=
PEAK_USER_TOKEN=
PEAK_API_BASE=https://api.peakaccount.com
# UAT: https://peakengineapidev.azurewebsites.net
# base64 (ค่าเริ่มต้น) หรือ hex — ถ้าเจอ signature error ให้สลับเป็น hex
PEAK_SIGNATURE_ENCODING=base64
# ส่งเลข PO ของเราเป็นเลขเอกสารใน PEAK (ปกติปล่อยให้ PEAK ออกเลขเอง)
PEAK_SEND_DOC_CODE=false
# ติด Department/Branch/Program ใน PEAK (รองรับเฉพาะ PEAK platform ใหม่)
PEAK_SYNC_CLASSIFICATION=false
